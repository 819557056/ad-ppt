# Root context allowlist. This overrides the legacy root .dockerignore.
**
!renderer/Dockerfile
!renderer/Dockerfile.dockerignore
!renderer/*.py
!renderer/*.mjs
!renderer/package.json
!renderer/package-lock.json
!renderer/requirements.lock.txt
!renderer/smoke.pptx
!backend/fonts/NotoSansSC-Regular.ttf
!backend/fonts/manifest.json
!deployment/scene/runtime.lock.json
!deployment/scene/verify_runtime.py
!deployment/scene/verify-apt.sh
!deployment/scene/check_browser.mjs
!deployment/scene/ubuntu.sources
!deployment/scene/ubuntu.inrelease-sha256
**/.env*
**/__pycache__/
**/node_modules/
**/instance/
**/uploads/
**/*.log
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/.git/
**/.pytest_cache/
**/.vite/
**/dist/
