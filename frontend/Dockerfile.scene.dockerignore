# Root context allowlist. This overrides the legacy root .dockerignore.
**
!frontend/Dockerfile.scene
!frontend/Dockerfile.scene.dockerignore
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/nginx.scene.conf
!frontend/vite.config.ts
!frontend/tsconfig*.json
!frontend/tailwind.config.js
!frontend/postcss.config.js
!frontend/src/**
!frontend/public/**
!deployment/scene/runtime.lock.json
!deployment/scene/verify_runtime.py
!deployment/scene/verify-apt.sh
**/.env*
**/__pycache__/
**/node_modules/
**/instance/
**/uploads/
**/*.log
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/.git/
**/.pytest_cache/
**/.vite/
**/dist/
