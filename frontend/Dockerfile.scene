# A Python preflight verifies shared lock hashes without adding Python to nginx.
FROM python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3 AS verified
WORKDIR /source
COPY . /source/
RUN python deployment/scene/verify_runtime.py verify --component frontend \
    && python deployment/scene/verify_runtime.py fingerprint > /source/runtime-lock.sha256

FROM node:22-bookworm@sha256:363e1587494626837fa7f9a23bdb453d13b0ff3c67c705c2805cfc69c2d2fad7 AS builder
WORKDIR /app/frontend
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ARG APP_VERSION_TAG=
ARG APP_COMMIT_SHA=
ARG APP_COMMIT_SHORT_SHA=
ENV VITE_APP_VERSION_TAG=${APP_VERSION_TAG} VITE_APP_COMMIT_SHA=${APP_COMMIT_SHA} VITE_APP_COMMIT_SHORT_SHA=${APP_COMMIT_SHORT_SHA}
COPY --from=verified /source/frontend/ /app/frontend/
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build:web \
    && (node --version && npm --version) > /app/build-runtime.txt

FROM nginx:stable-bookworm@sha256:552e7481ca93ffccd046aa658dbbed22caefbc09c66fa7cd247cbb90b8a5c609
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY --from=builder /app/frontend/nginx.scene.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build-runtime.txt /opt/scene/build-runtime.txt
COPY --from=verified /source/runtime-lock.sha256 /opt/scene/runtime-lock.sha256
RUN cat /opt/scene/runtime-lock.sha256 /opt/scene/build-runtime.txt > /opt/scene/runtime-manifest.txt \
    && nginx -v >> /opt/scene/runtime-manifest.txt 2>&1 \
    && dpkg-query -W -f='${Package}\t${Version}\n' > /opt/scene/packages.tsv \
    && LC_ALL=C sort /opt/scene/packages.tsv >> /opt/scene/runtime-manifest.txt
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
