# Root context allowlist. This overrides the legacy root .dockerignore.
**
!pyproject.toml
!uv.lock
!backend/*.py
!backend/alembic.ini
!backend/Dockerfile.scene
!backend/Dockerfile.scene.dockerignore
!backend/controllers/**/*.py
!backend/models/**/*.py
!backend/services/**/*.py
!backend/workers/**/*.py
!backend/ops/**/*.py
!backend/utils/**/*.py
!backend/migrations/**/*.py
!backend/migrations/script.py.mako
!backend/schemas/slide_scene_v1.schema.json
!backend/fonts/NotoSansSC-Regular.ttf
!backend/fonts/manifest.json
!assets/*.png
!assets/*.svg
!deployment/scene/runtime.lock.json
!deployment/scene/verify_runtime.py
!deployment/scene/verify-apt.sh
!deployment/scene/debian.sources
!deployment/scene/debian.inrelease-sha256
**/.env*
**/__pycache__/
**/node_modules/
**/instance/
**/uploads/
**/*.log
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/.git/
**/.pytest_cache/
**/.vite/
**/dist/
