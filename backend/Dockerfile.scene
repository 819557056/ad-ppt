# Scene production runtime. Upgrade digests and runtime.lock.json together.
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv
FROM python:3.12-slim-bookworm@sha256:54c85f3c47607a77f32adec749d3c81d1348bf25833671f512b26a9b6d778cb3
WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive UV_HTTP_TIMEOUT=300 UV_PYTHON_DOWNLOADS=never \
    PYTHONPATH=/app FLASK_APP=backend/app.py IN_DOCKER=1
COPY --from=uv /uv /usr/local/bin/uv
COPY . /app/
RUN python deployment/scene/verify_runtime.py verify --component backend \
    && rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
    && rm -rf /var/lib/apt/lists/* \
    && cp deployment/scene/debian.sources /etc/apt/sources.list.d/scene.sources \
    && apt-get update -o APT::Update::Error-Mode=any \
    && sh deployment/scene/verify-apt.sh deployment/scene/debian.inrelease-sha256 \
    && apt-get install -y --no-install-recommends curl ffmpeg fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
# Fail on a missing/stale lock or missing wheel. Never resolve/build at startup.
RUN uv sync --locked --no-dev --no-install-project --no-build \
    && mkdir -p /app/backend/instance /app/uploads /opt/scene \
    && /app/.venv/bin/python deployment/scene/verify_runtime.py record --component backend --output /opt/scene/runtime-manifest.json
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["sh", "-c", "curl -f http://localhost:5000/health || exit 1"]
CMD ["sh", "-c", "cd /app/backend && /app/.venv/bin/alembic upgrade head && exec /app/.venv/bin/python app.py"]
